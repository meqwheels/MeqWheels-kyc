{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meqwheels-kyc",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meq-wheels-kyc",
      "database_id": "699c3cc6-9c31-495a-bd86-069f035835c5"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "meq-wheels-documents"
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}